<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sachin Gaming</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#080b14;
    color:white;
}

header{
    position:sticky;
    top:0;
    z-index:100;
    background:#101522;
    border-bottom:1px solid #252b3a;
    padding:15px 5%;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-size:25px;
    font-weight:bold;
    color:#5cff91;
}

nav{
    display:flex;
    gap:25px;
    align-items:center;
}

nav a{
    color:#ddd;
    text-decoration:none;
    font-weight:bold;
}

nav a:hover{
    color:#5cff91;
}

.coins{
    background:#20283a;
    padding:10px 15px;
    border-radius:20px;
    color:#ffd43b;
    font-weight:bold;
}

.login-btn{
    background:#5cff91;
    color:#061009;
    border:0;
    padding:10px 18px;
    border-radius:20px;
    font-weight:bold;
    cursor:pointer;
}

.hero{
    min-height:430px;
    padding:70px 7%;
    display:flex;
    align-items:center;
    background:
    linear-gradient(90deg,#080b14 15%,rgba(8,11,20,.75),rgba(8,11,20,.2)),
    radial-gradient(circle at right,#174f36,#080b14 55%);
}

.hero-content{
    max-width:650px;
}

.hero h1{
    font-size:55px;
    margin-bottom:20px;
}

.hero h1 span{
    color:#5cff91;
}

.hero p{
    color:#b9c0ce;
    font-size:18px;
    line-height:1.6;
    margin-bottom:25px;
}

.explore{
    padding:14px 25px;
    border:0;
    border-radius:25px;
    background:#5cff91;
    font-weight:bold;
    cursor:pointer;
    font-size:16px;
}

section{
    padding:35px 5%;
}

.section-title{
    font-size:28px;
    margin-bottom:22px;
}

.categories{
    display:flex;
    gap:12px;
    overflow-x:auto;
    padding-bottom:10px;
}

.category{
    min-width:110px;
    padding:13px 18px;
    border:1px solid #303747;
    background:#111725;
    border-radius:25px;
    text-align:center;
    cursor:pointer;
}

.category:hover{
    background:#5cff91;
    color:#07120b;
}

.games{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(180px,1fr));
    gap:20px;
}

.game{
    background:#111725;
    border:1px solid #252d3d;
    border-radius:15px;
    overflow:hidden;
    transition:.25s;
}

.game:hover{
    transform:translateY(-5px);
    border-color:#5cff91;
}

.game img{
    width:100%;
    height:150px;
    object-fit:cover;
}

.game-info{
    padding:15px;
}

.game-info h3{
    margin-bottom:7px;
}

.game-info p{
    color:#8e97a9;
    font-size:13px;
    margin-bottom:12px;
}

.play{
    width:100%;
    padding:10px;
    border:0;
    border-radius:8px;
    background:#5cff91;
    font-weight:bold;
    cursor:pointer;
}

.search-box{
    width:100%;
    max-width:600px;
    margin:0 auto 30px;
    display:flex;
}

.search-box input{
    width:100%;
    padding:15px;
    border-radius:12px 0 0 12px;
    border:1px solid #303747;
    background:#111725;
    color:white;
    outline:none;
}

.search-box button{
    width:55px;
    border:0;
    background:#5cff91;
    border-radius:0 12px 12px 0;
    cursor:pointer;
}

.modal{
    display:none;
    position:fixed;
    inset:0;
    z-index:500;
    background:rgba(0,0,0,.75);
    align-items:center;
    justify-content:center;
}

.modal-box{
    width:90%;
    max-width:400px;
    background:#111725;
    border:1px solid #303747;
    padding:30px;
    border-radius:20px;
}

.modal-box h2{
    margin-bottom:20px;
}

.modal-box input{
    width:100%;
    padding:13px;
    margin:8px 0;
    background:#080b14;
    border:1px solid #303747;
    color:white;
    border-radius:8px;
}

.modal-box button{
    width:100%;
    padding:13px;
    margin-top:12px;
    border:0;
    border-radius:8px;
    background:#5cff91;
    font-weight:bold;
}

.close{
    float:right;
    cursor:pointer;
    color:#aaa;
    font-size:22px;
}

footer{
    margin-top:30px;
    padding:30px;
    text-align:center;
    color:#777f90;
    border-top:1px solid #222938;
}

@media(max-width:700px){
    header{
        padding:14px;
    }

    nav{
        gap:10px;
    }

    nav a{
        display:none;
    }

    .hero{
        min-height:400px;
        padding:50px 20px;
    }

    .hero h1{
        font-size:40px;
    }

    section{
        padding:30px 15px;
    }
}
</style>
</head>

<body>

<header>

    <div class="logo">🎮 Sachin Gaming</div>

    <nav>
        <a href="#home">Home</a>
        <a href="#games">Games</a>
        <a href="#categories">Categories</a>

        <div class="coins">
            🪙 <span id="coinCount">100</span>
        </div>

        <button class="login-btn" onclick="openLogin()">
            Login
        </button>
    </nav>

</header>


<!-- HOME -->

<div class="hero" id="home">

    <div class="hero-content">

        <h1>
            Welcome to <span>Sachin Gaming</span>
        </h1>

        <p>
            Play your favorite games, discover new adventures,
            collect coins and enjoy gaming all in one place.
        </p>

        <button class="explore"
                onclick="document.getElementById('games').scrollIntoView()">
            🎮 Explore Games
        </button>

    </div>

</div>


<!-- SEARCH -->

<section>

    <div class="search-box">

        <input
            id="searchInput"
            type="text"
            placeholder="Search games..."
            onkeyup="searchGames()">

        <button>🔍</button>

    </div>

</section>


<!-- CATEGORIES -->

<section id="categories">

    <h2 class="section-title">
        🎯 Game Categories
    </h2>

    <div class="categories">

        <div class="category" onclick="filterGames('all')">
            All
        </div>

        <div class="category" onclick="filterGames('action')">
            🔥 Action
        </div>

        <div class="category" onclick="filterGames('racing')">
            🏎️ Racing
        </div>

        <div class="category" onclick="filterGames('sports')">
            ⚽ Sports
        </div>

        <div class="category" onclick="filterGames('arcade')">
            👾 Arcade
        </div>

        <div class="category" onclick="filterGames('puzzle')">
            🧩 Puzzle
        </div>

        <div class="category" onclick="filterGames('adventure')">
            🗺️ Adventure
        </div>

    </div>

</section>


<!-- GAMES -->

<section id="games">

    <h2 class="section-title">
        🔥 Popular Games
    </h2>

    <div class="games" id="gameList">


        <div class="game" data-category="action"
             data-name="Shadow Warrior">

            <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=600&q=80">

            <div class="game-info">

                <h3>Shadow Warrior</h3>

                <p>Action • Adventure</p>

                <button class="play"
                        onclick="playGame('Shadow Warrior')">
                    ▶ Play
                </button>

            </div>

        </div>


        <div class="game" data-category="racing"
             data-name="Speed Racer">

            <img src="https://images.unsplash.com/photo-1503736334956-4c8f8e92946d?auto=format&fit=crop&w=600&q=80">

            <div class="game-info">

                <h3>Speed Racer</h3>

                <p>Racing • Cars</p>

                <button class="play"
                        onclick="playGame('Speed Racer')">
                    ▶ Play
                </button>

            </div>

        </div>


        <div class="game" data-category="sports"
             data-name="Football Stars">

            <img src="https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=600&q=80">

            <div class="game-info">

                <h3>Football Stars</h3>

                <p>Sports • Football</p>

                <button class="play"
                        onclick="playGame('Football Stars')">
                    ▶ Play
                </button>

            </div>

        </div>


        <div class="game" data-category="arcade"
             data-name="Galaxy Shooter">

            <img src="https://images.unsplash.com/photo-1614728263952-84ea256f9679?auto=format&fit=crop&w=600&q=80">

            <div class="game-info">

                <h3>Galaxy Shooter</h3>

                <p>Arcade • Space</p>

                <button class="play"
                        onclick="playGame('Galaxy Shooter')">
                    ▶ Play
                </button>

            </div>

        </div>


        <div class="game" data-category="puzzle"
             data-name="Brain Puzzle">

            <img src="https://images.unsplash.com/photo-1611996575749-79a3a250f948?auto=format&fit=crop&w=600&q=80">

            <div class="game-info">

                <h3>Brain Puzzle</h3>

                <p>Puzzle • Brain</p>

                <button class="play"
                        onclick="playGame('Brain Puzzle')">
                    ▶ Play
                </button>

            </div>

        </div>


        <div class="game" data-category="adventure"
             data-name="Lost Island">

            <img src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=600&q=80">

            <div class="game-info">

                <h3>Lost Island</h3>

                <p>Adventure • Explore</p>

                <button class="play"
                        onclick="playGame('Lost Island')">
                    ▶ Play
                </button>

            </div>

        </div>


    </div>

</section>


<!-- LOGIN -->

<div class="modal" id="loginModal">

    <div class="modal-box">

        <span class="close" onclick="closeLogin()">×</span>

        <h2>🔐 Sachin Gaming Login</h2>

        <input
            type="text"
            id="username"
            placeholder="Username">

        <input
            type="password"
            id="password"
            placeholder="Password">

        <button onclick="login()">
            Login
        </button>

    </div>

</div>


<footer>

    © 2026 <b>Sachin Gaming</b> • All Rights Reserved 🎮

</footer>


<script>

let coins = 100;


/* LOGIN */

function openLogin(){
    document.getElementById("loginModal").style.display="flex";
}

function closeLogin(){
    document.getElementById("loginModal").style.display="none";
}

function login(){

    let username =
        document.getElementById("username").value;

    if(username.trim()===""){
        alert("Please enter your username.");
        return;
    }

    localStorage.setItem("sachinUser",username);

    alert("Welcome " + username + " 🎮");

    closeLogin();
}


/* PLAY GAME */

function playGame(gameName){

    if(coins < 5){
        alert("Not enough coins!");
        return;
    }

    coins -= 5;

    document.getElementById("coinCount").innerText = coins;

    localStorage.setItem("sachinCoins",coins);

    alert(
        "🎮 Starting " +
        gameName +
        "!\n\n5 coins used."
    );

}


/* SEARCH */

function searchGames(){

    let search =
        document.getElementById("searchInput")
        .value
        .toLowerCase();

    let games =
        document.querySelectorAll(".game");

    games.forEach(game => {

        let name =
            game.dataset.name.toLowerCase();

        if(name.includes(search)){
            game.style.display="block";
        }else{
            game.style.display="none";
        }

    });

}


/* CATEGORY FILTER */

function filterGames(category){

    let games =
        document.querySelectorAll(".game");

    games.forEach(game => {

        if(
            category === "all" ||
            game.dataset.category === category
        ){

            game.style.display="block";

        }else{

            game.style.display="none";

        }

    });

}


/* LOAD COINS */

window.onload = function(){

    let savedCoins =
        localStorage.getItem("sachinCoins");

    if(savedCoins){
        coins = Number(savedCoins);
        document.getElementById("coinCount")
        .innerText = coins;
    }

};

</script>

</body>
</html>m
